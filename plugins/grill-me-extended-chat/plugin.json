{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "grill-me-extended-chat",
  "version": "1.0.0",
  "description": "在 ChatGPT 中通过分轮决策访谈、候选计划和逐项自审，形成可交接的计划、进度与执行说明。独立运行，无需 MCP 服务器。",
  "author": { "name": "SweetDumplingPorridge", "url": "https://github.com/SweetDumplingPorridge" },
  "homepage": "https://github.com/SweetDumplingPorridge/grill-me-extended-cloud",
  "repository": "https://github.com/SweetDumplingPorridge/grill-me-extended-cloud",
  "keywords": ["interview", "planning", "grill-me", "Chinese"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Grill Me Extended Chat",
        "shortDescription": "决策访谈、计划编写与逐项自审",
        "longDescription": "由当前 ChatGPT 采访用户并审核计划，每轮提出 3–7 个关键问题，收敛范围、约束和决策，交付计划.md、进度.md、AGENTS.md。无需服务器或 API 密钥。使用聊天问答，不提供 MCP 交互式问卷或独立持久化存储。跨聊天恢复需要用户提供会话检查点；文件下载取决于宿主能力。",
        "developerName": "SweetDumplingPorridge",
        "category": "Productivity",
        "capabilities": [],
        "websiteURL": "https://github.com/SweetDumplingPorridge/grill-me-extended-cloud",
        "defaultPrompt": ["拷问我，把我的想法变成可执行的计划。", "继续我提供的访谈检查点，补齐关键决策并自审计划。"],
        "brandColor": "#3740A4",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg"
      }
    }
  }
}
